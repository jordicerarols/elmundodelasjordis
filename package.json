{
  "name": "jordis",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create jordis-db",
    "db:migrate": "wrangler d1 execute jordis-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute jordis-db --remote --file=schema.sql",
    "db:migrate:subtitulo": "wrangler d1 execute jordis-db --local --file=migrate-add-subtitulo.sql",
    "db:migrate:subtitulo:remote": "wrangler d1 execute jordis-db --remote --file=migrate-add-subtitulo.sql",
    "db:backfill-hashtags": "node scripts/backfill-hashtags.mjs --local",
    "db:backfill-hashtags:remote": "node scripts/backfill-hashtags.mjs --remote",
    "r2:create": "wrangler r2 bucket create jordis-storage"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.69.0"
  }
}
